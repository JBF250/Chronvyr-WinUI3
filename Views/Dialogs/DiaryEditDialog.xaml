<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Chronvyr.Views.Dialogs.DiaryEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    CloseButtonText="{x:Bind Loc.T('ActionCancel')}"
    DefaultButton="Primary"
    PrimaryButtonText="{x:Bind Loc.T('ActionCreate')}">

    <StackPanel MinWidth="420" Spacing="14">
        <TextBox
            x:Name="TitleBox"
            Header="{x:Bind Loc.T('FieldTitle')}"
            PlaceholderText="{x:Bind Loc.T('DiaryUntitled')}"
            TextWrapping="Wrap" />

        <DatePicker
            x:Name="DateBox"
            HorizontalAlignment="Stretch"
            Header="{x:Bind Loc.T('FieldDate')}" />

        <TextBox
            x:Name="ContentBox"
            Height="220"
            AcceptsReturn="True"
            Header="{x:Bind Loc.T('FieldContent')}"
            PlaceholderText="{x:Bind Loc.T('DiaryContentPlaceholder')}"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            TextWrapping="Wrap" />
    </StackPanel>
</ContentDialog>
