<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Chronvyr.Views.Dialogs.ScheduleEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    CloseButtonText="{x:Bind Loc.T('ActionCancel')}"
    DefaultButton="Primary"
    PrimaryButtonText="{x:Bind Loc.T('ActionSave')}">

    <StackPanel MinWidth="400" Spacing="14">
        <TextBox
            x:Name="TitleBox"
            Header="{x:Bind Loc.T('FieldTitle')}"
            PlaceholderText="{x:Bind Loc.T('FieldTitlePlaceholder')}"
            TextWrapping="Wrap" />

        <!-- 日期只到「天」，省下的高度留给描述 -->
        <TextBox
            x:Name="DescBox"
            Height="150"
            AcceptsReturn="True"
            Header="{x:Bind Loc.T('FieldDescription')}"
            PlaceholderText="{x:Bind Loc.T('FieldDescPlaceholder')}"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            TextWrapping="Wrap" />

        <!--
            日期各占整行：中文的 DatePicker 要排下「2026年 / 9月 / 19日」三列，
            半宽放不下会把「日」挤出可视区域。
        -->
        <DatePicker
            x:Name="StartDatePicker"
            HorizontalAlignment="Stretch"
            Header="{x:Bind Loc.T('FieldStartDate')}" />

        <DatePicker
            x:Name="DueDatePicker"
            HorizontalAlignment="Stretch"
            Header="{x:Bind Loc.T('FieldDueDate')}" />
    </StackPanel>
</ContentDialog>
