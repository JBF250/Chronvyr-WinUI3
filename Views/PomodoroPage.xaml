<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Chronvyr.Views.PomodoroPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Style="{StaticResource ChronvyrPageRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,16"
            FontSize="24"
            FontWeight="SemiBold"
            Text="{x:Bind Loc.T('PomodoroTitle')}" />

        <Grid Grid.Row="1" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <!-- 计时区 -->
            <Border
                Grid.Column="0"
                Padding="24"
                Style="{StaticResource ChronvyrCardStyle}">
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="26">

                    <Grid Width="264" Height="264">
                        <!-- 背景轨道：让计时器在 0% 时也能看出形状 -->
                        <Ellipse
                            Width="252"
                            Height="252"
                            Opacity="0.45"
                            Stroke="{ThemeResource ChronvyrDividerBrush}"
                            StrokeThickness="4" />
                        <ProgressRing
                            Width="264"
                            Height="264"
                            Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                            IsActive="True"
                            IsIndeterminate="False"
                            Value="{x:Bind ViewModel.Progress, Mode=OneWay}" />
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="6">
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="54"
                                FontWeight="SemiBold"
                                Text="{x:Bind ViewModel.TimeText, Mode=OneWay}" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Style="{StaticResource ChronvyrSubtleTextStyle}"
                                Text="{x:Bind ViewModel.StateText, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="12">
                        <Button
                            Command="{x:Bind ViewModel.StartCommand}"
                            Content="{x:Bind Loc.T('PomodoroStart')}"
                            Style="{StaticResource AccentButtonStyle}"
                            Visibility="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
                        <Button
                            Command="{x:Bind ViewModel.StartCommand}"
                            Content="{x:Bind Loc.T('PomodoroResume')}"
                            Style="{StaticResource AccentButtonStyle}"
                            Visibility="{x:Bind ViewModel.IsPaused, Mode=OneWay}" />
                        <Button
                            Command="{x:Bind ViewModel.StartCommand}"
                            Content="{x:Bind Loc.T('PomodoroAgain')}"
                            Style="{StaticResource AccentButtonStyle}"
                            Visibility="{x:Bind ViewModel.IsFinished, Mode=OneWay}" />
                        <Button
                            Command="{x:Bind ViewModel.PauseCommand}"
                            Content="{x:Bind Loc.T('PomodoroPause')}"
                            Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay}" />
                        <Button Command="{x:Bind ViewModel.ResetCommand}" Content="{x:Bind Loc.T('PomodoroReset')}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 任务与设置 -->
            <Border
                Grid.Column="1"
                Padding="20"
                Style="{StaticResource ChronvyrCardStyle}">
                <StackPanel Spacing="18">
                    <TextBlock Style="{StaticResource ChronvyrSectionTitleStyle}" Text="{x:Bind Loc.T('PomodoroTaskSection')}" />

                    <TextBox
                        Header="{x:Bind Loc.T('PomodoroTaskLabel')}"
                        PlaceholderText="{x:Bind Loc.T('PomodoroTaskPlaceholder')}"
                        Text="{x:Bind ViewModel.TaskName, Mode=TwoWay}"
                        TextWrapping="Wrap" />

                    <Button
                        HorizontalAlignment="Stretch"
                        Click="OnPickScheduleClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE8FD;" />
                            <TextBlock Text="{x:Bind Loc.T('PomodoroPickSchedule')}" />
                        </StackPanel>
                    </Button>

                    <NumberBox
                        Header="{x:Bind Loc.T('PomodoroDuration')}"
                        Maximum="180"
                        Minimum="1"
                        SpinButtonPlacementMode="Inline"
                        Value="{x:Bind ViewModel.FocusMinutes, Mode=TwoWay}" />

                    <InfoBar
                        x:Name="DoneBar"
                        IsClosable="True"
                        IsOpen="False"
                        Message="本轮专注已结束，休息一下吧。"
                        Severity="Success"
                        Title="番茄钟完成" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
