<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Chronvyr.Views.SchedulePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:Chronvyr.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:Chronvyr.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Chronvyr.Models"
    mc:Ignorable="d">

    <Page.Resources>
        <conv:BoolToOpacityConverter x:Key="CompletedOpacity" FalseOpacity="1.0" TrueOpacity="0.45" />
        <conv:StringToVisibilityConverter x:Key="StringVisibility" />

        <DataTemplate x:Key="ScheduleRowTemplate" x:DataType="models:ScheduleItem">
            <Border
                Margin="0,0,0,8"
                Padding="14,12"
                Background="{ThemeResource ChronvyrCardBrush}"
                BorderBrush="{ThemeResource ChronvyrCardStrokeBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Opacity="{x:Bind IsCompleted, Mode=OneWay, Converter={StaticResource CompletedOpacity}}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <CheckBox
                        Grid.Column="0"
                        MinWidth="0"
                        Margin="0,2,0,0"
                        VerticalAlignment="Top"
                        IsChecked="{x:Bind IsCompleted, Mode=TwoWay}"
                        ToolTipService.ToolTip="{x:Bind helpers:Loc.MarkCompletedTip}" />

                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock
                            FontSize="15"
                            FontWeight="SemiBold"
                            Text="{x:Bind Title, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Style="{StaticResource ChronvyrSubtleTextStyle}"
                            Text="{x:Bind Description, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind Description, Mode=OneWay, Converter={StaticResource StringVisibility}}" />
                        <TextBlock
                            Style="{StaticResource ChronvyrSubtleTextStyle}"
                            Text="{x:Bind RangeText, Mode=OneWay}" />
                    </StackPanel>

                    <Button
                        Grid.Column="2"
                        Padding="8"
                        VerticalAlignment="Top"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnEditScheduleClick"
                        Tag="{x:Bind}"
                        ToolTipService.ToolTip="{x:Bind helpers:Loc.EditTip}">
                        <FontIcon FontSize="14" Glyph="&#xE70F;" />
                    </Button>

                    <Button
                        Grid.Column="3"
                        Padding="8"
                        VerticalAlignment="Top"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnDeleteScheduleClick"
                        Tag="{x:Bind}"
                        ToolTipService.ToolTip="{x:Bind helpers:Loc.DeleteTip}">
                        <FontIcon FontSize="14" Glyph="&#xE74D;" />
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Style="{StaticResource ChronvyrPageRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel
                Orientation="Horizontal"
                Spacing="12"
                VerticalAlignment="Center">
                <TextBlock
                    FontSize="24"
                    FontWeight="SemiBold"
                    Text="{x:Bind Loc.T('ScheduleTitle')}" />
                <TextBlock
                    Margin="0,0,0,4"
                    VerticalAlignment="Bottom"
                    Style="{StaticResource ChronvyrSubtleTextStyle}"
                    Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}" />
            </StackPanel>

            <Button
                HorizontalAlignment="Right"
                Click="OnNewScheduleClick"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE710;" />
                    <TextBlock Text="{x:Bind Loc.T('ScheduleNew')}" />
                </StackPanel>
            </Button>
        </Grid>

        <StackPanel
            Grid.Row="1"
            Margin="0,0,0,14"
            Orientation="Horizontal"
            Spacing="18">
            <RadioButton
                Content="{x:Bind Loc.T('ScheduleFilterAll')}"
                GroupName="ScheduleFilter"
                IsChecked="True"
                Tag="all"
                Checked="OnFilterChecked" />
            <RadioButton
                Content="{x:Bind Loc.T('ScheduleFilterPending')}"
                GroupName="ScheduleFilter"
                Tag="pending"
                Checked="OnFilterChecked" />
            <RadioButton
                Content="{x:Bind Loc.T('ScheduleFilterCompleted')}"
                GroupName="ScheduleFilter"
                Tag="completed"
                Checked="OnFilterChecked" />
        </StackPanel>

        <Border
            Grid.Row="2"
            Padding="14"
            Style="{StaticResource ChronvyrCardStyle}">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl
                        ItemTemplate="{StaticResource ScheduleRowTemplate}"
                        ItemsSource="{x:Bind ViewModel.Items}" />
                </ScrollViewer>

                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8"
                    Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                    <FontIcon
                        FontSize="28"
                        Glyph="&#xE8FD;"
                        Opacity="0.4" />
                    <TextBlock
                        Style="{StaticResource ChronvyrSubtleTextStyle}"
                        Text="{x:Bind Loc.T('ScheduleEmpty')}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
