<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Chronvyr.Views.DiaryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Chronvyr.Models"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="DiaryListItemTemplate" x:DataType="models:DiaryEntry">
            <Grid Margin="0,4" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="3">
                    <TextBlock
                        FontWeight="SemiBold"
                        Text="{x:Bind Title, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Style="{StaticResource ChronvyrSubtleTextStyle}"
                        Text="{x:Bind DateText, Mode=OneWay}" />
                    <TextBlock
                        MaxLines="2"
                        Opacity="0.6"
                        Style="{StaticResource ChronvyrSubtleTextStyle}"
                        Text="{x:Bind Preview, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Style="{StaticResource ChronvyrPageRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel
                Orientation="Horizontal"
                Spacing="12"
                VerticalAlignment="Center">
                <TextBlock
                    FontSize="24"
                    FontWeight="SemiBold"
                    Text="{x:Bind Loc.T('DiaryTitle')}" />
            </StackPanel>

            <Button
                HorizontalAlignment="Right"
                Click="OnNewDiaryClick"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE710;" />
                    <TextBlock Text="{x:Bind Loc.T('DiaryNew')}" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 历史日记（FR-4.3 按日期查看） -->
            <Border
                Grid.Column="0"
                Padding="10"
                Style="{StaticResource ChronvyrCardStyle}">
                <Grid>
                    <ListView
                        x:Name="DiaryList"
                        Background="Transparent"
                        ItemTemplate="{StaticResource DiaryListItemTemplate}"
                        ItemsSource="{x:Bind ViewModel.Entries}"
                        SelectedItem="{x:Bind ViewModel.SelectedEntry, Mode=TwoWay}"
                        SelectionMode="Single" />

                    <TextBlock
                        Margin="12"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Style="{StaticResource ChronvyrSubtleTextStyle}"
                        Text="{x:Bind Loc.T('DiaryEmpty')}"
                        Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />
                </Grid>
            </Border>

            <!-- 编辑区 -->
            <Border
                Grid.Column="1"
                Padding="20"
                Style="{StaticResource ChronvyrCardStyle}">
                <Grid>
                    <StackPanel Spacing="14" Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
                        <!--
                            UpdateSourceTrigger=PropertyChanged：默认是失焦才写回，
                            边打字边切页 / 关窗口就会丢掉最后一段输入。
                        -->
                        <TextBox
                            Header="{x:Bind Loc.T('FieldTitle')}"
                            Text="{x:Bind ViewModel.EditingTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap" />

                        <DatePicker Header="{x:Bind Loc.T('FieldDate')}" Date="{x:Bind ViewModel.EditingDate, Mode=TwoWay}" />

                        <TextBox
                            Height="360"
                            Header="{x:Bind Loc.T('FieldContent')}"
                            AcceptsReturn="True"
                            PlaceholderText="{x:Bind Loc.T('DiaryContentPlaceholder')}"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            Text="{x:Bind ViewModel.EditingContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap" />

                        <StackPanel
                            HorizontalAlignment="Left"
                            Orientation="Horizontal"
                            Spacing="12">
                            <Button
                                Click="OnSaveDiaryClick"
                                Content="{x:Bind Loc.T('ActionSave')}"
                                Style="{StaticResource AccentButtonStyle}" />

                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource ChronvyrSubtleTextStyle}"
                                Text="{x:Bind ViewModel.SaveHint, Mode=OneWay}" />

                            <Button Click="OnDeleteDiaryClick">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                    <TextBlock Text="{x:Bind Loc.T('DiaryDeleteButton')}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Style="{StaticResource ChronvyrSubtleTextStyle}"
                        Text="{x:Bind Loc.T('DiaryNoSelection')}"
                        Visibility="{x:Bind ViewModel.IsNothingSelected, Mode=OneWay}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
